# Safe defaults. Both values must be changed deliberately before live wiring is enabled.
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

MAX_NOTIONAL_PER_ORDER=100
MAX_POSITION_PER_MARKET=500
MAX_DAILY_LOSS=250
KILL_SWITCH=false
LOG_LEVEL=INFO

# Kalshi demo is the default environment.
KALSHI_ENV=demo
KALSHI_ACCESS_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Free public odds for the tennis_basis track (The Odds API Starter plan: 500 credits/month,
# key by e-mail sign-up, no payment details). Optional; without it the track is an honest empty.
ODDS_API_KEY=

# Weather calibration A/B uses Open-Meteo's free endpoints (no key). A paid Open-Meteo key is only
# read when the CLI is run with --allow-paid-keys; leave empty for the default free path.
OPEN_METEO_API_KEY=

# Polymarket CLOB V2. Never commit a wallet private key or API secret.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
