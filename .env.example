# Safe defaults. Both values must be changed deliberately before live wiring is enabled.
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

MAX_NOTIONAL_PER_ORDER=100
MAX_POSITION_PER_MARKET=500
MAX_DAILY_LOSS=250
KILL_SWITCH=false
LOG_LEVEL=INFO

# Kalshi demo is the default environment.
KALSHI_ENV=demo
KALSHI_ACCESS_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Polymarket CLOB V2. Never commit a wallet private key or API secret.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
